# ====================
# LLM Provider Configuration
# ====================

# LLM provider to use: "openai" or "gemini"
# For lowest latency, use gemini with gemini-2.0-flash-exp
LLM_PROVIDER=gemini

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (recommended for low latency)
# Gemini 2.0 Flash has ~200-400ms TTFT vs ~500-800ms for GPT-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# ====================
# LLM Parameters
# ====================

LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=  # Optional, leave empty for model default
# Reduced from 5 to 3 for faster context processing
LLM_MAX_CONTEXT_MESSAGES=3
LLM_SYSTEM_PROMPT=You are a helpful voice assistant. Provide concise, natural responses suitable for voice interaction.

# Canvas mode system prompt (optional)
# LLM_CANVAS_SYSTEM_PROMPT=

# ====================
# Speech-to-Text (Deepgram)
# ====================

DEEPGRAM_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova

# Endpointing: milliseconds of silence before finalizing transcript
# With VAD endpoint detection enabled (default), this serves as backup only
# VAD detects speech end in ~300ms, so Deepgram endpointing is set lower
# Default: 500ms (reduced from 1800ms when VAD is enabled)
DEEPGRAM_ENDPOINTING=500

# ====================
# VAD-Based Endpoint Detection (NEW)
# ====================
# Silero VAD detects speech end in ~300ms vs Deepgram's 1800ms default
# This is the key optimization for achieving sub-500ms non-LLM latency

VAD_ENDPOINT_ENABLED=true
# Silence duration (ms) before triggering endpoint
VAD_SILENCE_THRESHOLD_MS=300
# Minimum speech duration (ms) before considering endpoint
VAD_MIN_SPEECH_MS=100
# Minimum words in transcript to trigger endpoint
VAD_MIN_WORDS=1
# VAD speech probability threshold (0.0-1.0)
VAD_THRESHOLD=0.3

# ====================
# Sentence-Level TTS Streaming (NEW)
# ====================
# Start TTS on first sentence instead of waiting for full LLM response
# Reduces latency by ~300-500ms

SENTENCE_STREAM_ENABLED=true
# Minimum characters for a valid sentence
MIN_SENTENCE_CHARS=15

# ====================
# Text-to-Speech (ElevenLabs)
# ====================

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# TTS Parameters
TTS_STABILITY=0.5
TTS_SIMILARITY_BOOST=0.75
TTS_STYLE=0.0
TTS_USE_SPEAKER_BOOST=true

# ====================
# Memory (Mem0)
# ====================

# Optional - for long-term memory features
# MEM0_API_KEY=your_mem0_api_key_here

# ====================
# Server Configuration
# ====================

HOST=0.0.0.0
PORT=8000
