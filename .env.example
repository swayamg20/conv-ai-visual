# ====================
# LLM Provider Configuration
# ====================

# LLM provider to use: "groq", "openai", or "gemini" (default: groq)
LLM_PROVIDER=groq

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# ====================
# LLM Parameters
# ====================

LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=  # Optional, leave empty for model default
LLM_MAX_CONTEXT_MESSAGES=20
LLM_SYSTEM_PROMPT=You are a helpful voice assistant. Provide concise, natural responses suitable for voice interaction.
LLM_ASYNC_CONTEXT=true
LLM_TOOL_SCHEMA_CACHE=true
LLM_STREAM_TOOL_ORCHESTRATION=true
LLM_PARALLEL_TOOLS=true

# Gate 1 paid scene authoring is disabled unless deliberately enabled.
MURMUR_SCENE_ENABLED=false
MURMUR_SCENE_LLM_MAX_TOKENS=4096
MURMUR_SCENE_GLOBAL_CONCURRENCY=4
MURMUR_SCENE_PER_USER_CONCURRENCY=1
MURMUR_SCENE_REQUESTS_PER_MINUTE=10

# Canvas mode system prompt (optional)
# LLM_CANVAS_SYSTEM_PROMPT=

# ====================
# Speech-to-Text (Deepgram)
# ====================

DEEPGRAM_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova

# Endpointing: milliseconds of silence before finalizing transcript
# Higher = wait longer for user to continue (better for natural pauses, but slower response)
# Lower = faster finalization (but may cut off mid-sentence)
# Recommended values:
#   - 1000-1200: Fast response, may occasionally cut off during pauses
#   - 1500-1800: Good for natural speech with breathing pauses (recommended)
#   - 2000+: Very patient, best for speakers with long pauses
# Default: 700 (0.7 seconds)
DEEPGRAM_ENDPOINTING=700
DEEPGRAM_UTTERANCE_END_MS=1000

# ====================
# Text-to-Speech (ElevenLabs)
# ====================

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# TTS Parameters
TTS_STABILITY=0.5
TTS_SIMILARITY_BOOST=0.75
TTS_STYLE=0.0
TTS_USE_SPEAKER_BOOST=true
TTS_MAX_RETRIES=2
TTS_RETRY_BASE_DELAY_SECS=0.35
TTS_FALLBACK_TO_KOKORO=true

# ====================
# Smart Turn Detection (pipecat-ai/smart-turn-v3)
# ====================

# Enable Smart Turn for better conversational turn detection (default: false).
# Install it first with: uv sync --locked --extra dev --extra smart-turn
# When enabled, uses a Whisper-based ML model to detect when the user
# has finished speaking, instead of relying solely on silence duration. An
# enabled model that cannot initialize makes voice unavailable; it never
# silently changes the selected turn detector.
SMART_TURN_ENABLED=false

# Probability threshold for turn completion (0.0-1.0, default: 0.5)
# Higher = more conservative (waits longer to confirm turn is done)
# Lower = more aggressive (triggers LLM response sooner)
SMART_TURN_THRESHOLD=0.5

# Fallback silence timeout in seconds (default: 2.0)
# If Smart Turn says "incomplete" but silence continues this long, force-complete.
SMART_TURN_STOP_SECS=2.0

# Optional: path to custom ONNX model file (auto-downloads from HuggingFace if not set)
# SMART_TURN_MODEL_PATH=

# ====================
# Memory (Mem0)
# ====================

# Optional - for long-term memory features
# MEM0_API_KEY=your_mem0_api_key_here
MEMORY_SEMANTIC_TIMEOUT_SECS=1.0

# Optional - for the built-in web search tool
# TAVILY_API_KEY=your_tavily_api_key_here

# ====================
# Firebase Auth
# ====================

# Firebase project used by the frontend and backend token verification
FIREBASE_PROJECT_ID=omnisave-21c05

# Optional: path to a Firebase service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# ====================
# Server Configuration
# ====================

# Local runtime state is stored under this ignored directory.
MURMUR_DATA_DIR=./var

# Optional full SQLAlchemy URL override, primarily for tests and deployments.
# MURMUR_DATABASE_URL=sqlite:///./var/murmur.db

# Comma-separated frontend origins allowed to call the backend
ALLOWED_CORS_ORIGINS=http://localhost:3000

HOST=0.0.0.0
PORT=8000

# ====================
# Voice V2 / LiveKit (optional canary runtime)
# ====================

# Keep legacy until the Voice V2 browser-to-worker acceptance gates pass.
VOICE_RUNTIME=legacy
MURMUR_ENVIRONMENT=development

# Required only when VOICE_RUNTIME=livekit_v2.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# Generate at least 32 random bytes; never expose this value to the browser.
# VOICE_V2_SIGNING_SECRET=your_server_only_signing_secret

VOICE_V2_PROFILE_ID=livekit-agents-cascade-v1
VOICE_V2_WORKER_NAME=murmur-voice-v2
VOICE_V2_TOKEN_TTL_SECONDS=300
VOICE_V2_JOB_METADATA_TTL_SECONDS=300
VOICE_V2_JOB_METADATA_CLOCK_SKEW_SECONDS=30
VOICE_V2_REPOSITORY_TIMEOUT_SECONDS=2
VOICE_V2_PREFLIGHT_TIMEOUT_SECONDS=5
VOICE_V2_CONNECT_TIMEOUT_SECONDS=10
VOICE_V2_PARTICIPANT_WAIT_TIMEOUT_SECONDS=15
VOICE_V2_INPUT_WAIT_TIMEOUT_SECONDS=10
VOICE_V2_SESSION_START_TIMEOUT_SECONDS=10
VOICE_V2_EVENT_PUBLISH_TIMEOUT_SECONDS=3
# Metadata-only Deepgram/Groq/ElevenLabs reachability budget. This does not
# generate audio or tokens and does not prove provider streaming capacity.
VOICE_V2_PROVIDER_PROBE_TIMEOUT_SECONDS=4
VOICE_V2_ROOM_EMPTY_TIMEOUT_SECONDS=60
VOICE_V2_ROOM_DEPARTURE_TIMEOUT_SECONDS=30
VOICE_V2_CONTROL_PLANE_TIMEOUT_SECONDS=5
VOICE_V2_MAX_CONCURRENT_BOOTSTRAPS=100
VOICE_V2_MAX_ACTIVE_CALLS=1
VOICE_V2_MAX_CALL_ASSIGNMENTS=10000
