{
  "name": "murmur-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "e2e:scene": "playwright test --config=playwright.scene.config.ts",
    "test:choreography-artifacts": "node --test scripts/live-choreography-artifacts.node-test.mjs",
    "test:choreography-review": "node --test scripts/live-choreography-review.node-test.mjs",
    "prepare:choreography-artifacts": "node scripts/live-choreography-artifacts.mjs prepare",
    "e2e:choreography": "CHOREOGRAPHY_E2E_SUITE=accelerated playwright test --config=playwright.choreography.config.ts",
    "capture:choreography": "CHOREOGRAPHY_E2E_SUITE=capture playwright test --config=playwright.choreography.config.ts",
    "e2e:parametric-choreography": "playwright test --config=playwright.parametric-choreography.config.ts",
    "e2e:parametric-choreography:capture": "PARAMETRIC_CHOREOGRAPHY_E2E_SUITE=capture playwright test --config=playwright.parametric-choreography.config.ts",
    "e2e:parametric-choreography:product-smoke": "PARAMETRIC_CHOREOGRAPHY_E2E_SUITE=product-smoke playwright test --config=playwright.parametric-choreography.config.ts",
    "test:projectile-motion-artifacts": "node --test scripts/projectile-motion-artifacts.node-test.mjs",
    "prepare:projectile-motion-artifacts": "node scripts/projectile-motion-artifacts.mjs prepare",
    "e2e:projectile-motion": "PROJECTILE_MOTION_E2E_SUITE=accelerated playwright test --config=playwright.projectile-motion.config.ts",
    "e2e:projectile-motion:capture": "PROJECTILE_MOTION_E2E_SUITE=capture playwright test --config=playwright.projectile-motion.config.ts",
    "e2e:projectile-motion:product-smoke": "PROJECTILE_MOTION_E2E_SUITE=product-smoke playwright test --config=playwright.projectile-motion.config.ts",
    "finalize:projectile-motion-artifacts": "node scripts/projectile-motion-artifacts.mjs finalize",
    "validate:projectile-motion-artifacts": "node scripts/validate-projectile-motion-artifacts.mjs",
    "finalize:choreography-artifacts": "node scripts/live-choreography-artifacts.mjs finalize",
    "validate:choreography-artifacts": "node scripts/validate-live-choreography-artifacts.mjs",
    "validate:choreography-review": "node scripts/validate-live-choreography-review.mjs",
    "e2e:voice": "playwright test e2e/voice-rtc.spec.ts",
    "test:e2e:offline": "playwright test e2e/voice-rtc.spec.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude=e2e/**",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@daily-co/daily-js": "0.90.0",
    "@pipecat-ai/client-js": "1.13.0",
    "@pipecat-ai/small-webrtc-transport": "1.10.6",
    "@ricky0123/vad-react": "^0.0.36",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.12.5",
    "katex": "^0.16.9",
    "livekit-client": "2.21.0",
    "lucide-react": "^0.469.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "perfect-freehand": "^1.2.3",
    "postcss": "^8.4.49",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-katex": "^3.0.1",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
